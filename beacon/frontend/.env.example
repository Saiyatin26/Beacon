# BEACON Frontend Environment Configuration

# Development:
# VITE_API_BASE_URL=http://localhost:8000

# Production (Same-origin reverse proxy / API gateway):
# VITE_API_BASE_URL=

# Production (Separate API domain):
# VITE_API_BASE_URL=https://api.example.com

# SECURITY NOTE:
# Never place backend secrets (JWT_SECRET_KEY, API keys, database passwords)
# in frontend environment files as VITE_* variables are exposed to the browser bundle.

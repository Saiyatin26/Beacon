# ==============================================================================
# LLM Provider Hierarchy (Stage 2 — Invariant Hypothesis Mining)
# ==============================================================================
# Selection: gemini | openrouter | anthropic | ollama | offline
LLM_PROVIDER=gemini
ALLOW_AUTO_FALLBACK=false

# Primary Cloud Provider: OpenRouter (Exclusive AI provider for Full BEACON)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supported Cloud Provider: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supported Cloud Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Fallback Provider: Ollama (Qwen or Mistral)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ==============================================================================
# Optional Storage & Embeddings
# ==============================================================================
# MongoDB Atlas (invariant storage, vector dedup, certification history)
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=beacon

# Voyage AI embeddings (used by Atlas Vector Search for invariant dedup)
VOYAGE_API_KEY=

# ==============================================================================
# Tunable Scoring Defaults
# ==============================================================================
CONFIDENCE_THRESHOLD=0.8
SEVERITY_WEIGHT_CRITICAL=4
SEVERITY_WEIGHT_HIGH=3
SEVERITY_WEIGHT_MEDIUM=2
SEVERITY_WEIGHT_LOW=1
DRIFT_ALERT_DELTA_PCT=2.0

# ==============================================================================
# Phase 17 Authentication & Security Configuration
# ==============================================================================
# JWT_SECRET_KEY is required for authenticating API requests.
# A real, cryptographically secure secret (minimum 32 characters) must be supplied
# through the deployment environment or a secure secret manager (e.g., AWS Secrets
# Manager, HashiCorp Vault).
# The actual secret must NEVER be committed to Git or hardcoded in configuration files.
# The empty value below is intentional and is only a placeholder; production startup
# will safely fail fast if JWT_SECRET_KEY is missing or empty.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Phase 18 Observability, Logging & Operational Diagnostics Configuration
# ==============================================================================
# Minimum logging level for structured JSON application logs (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Threshold in milliseconds to flag and log slow HTTP requests / operations
SLOW_REQUEST_THRESHOLD_MS=2000

# Toggle in-memory operational metrics collection
METRICS_ENABLED=true

# Application build & version identifier reported in safe version endpoints
BEACON_VERSION=1.0.0

# ==============================================================================
# Phase 20 Environment Mode & Operational Topology
# ==============================================================================
# Runtime environment: production | staging | development | test
# In production, strict security validation is enforced and missing secrets will fail fast.
BEACON_ENV=development

# Allowed CORS Origins (comma-separated list of fully qualified origins)
# Never use wildcard '*' with credentials in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional custom SQLite database storage path (defaults to ./beacon.sqlite3)
# BEACON_DATABASE_PATH=./data/beacon.sqlite3

# Phase 16 Workload Limits
MAX_DATASET_SIZE_BYTES=10485760
MAX_INPUT_RECORDS=5000
MAX_REQUEST_BODY_BYTES=15728640
MAX_CONCURRENT_JOBS=10

# ==============================================================================
# Phase 19 Reliability, Resilience, Lifecycle Management & Operational Safety
# ==============================================================================
# Maximum allowed execution time in seconds for long-running operations
OPERATION_TIMEOUT_SECONDS=60.0

# Maximum bounded retry attempts for transient dependency failures
MAX_RETRY_ATTEMPTS=3

# Base backoff delay in milliseconds for exponential retry backoff
RETRY_BACKOFF_BASE_MS=100.0

# Age threshold in seconds for detecting interrupted / stale active jobs on startup
STALE_OPERATION_THRESHOLD_SECONDS=300.0

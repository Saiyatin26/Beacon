# ==============================================================================
# LLM Provider Hierarchy (Stage 2 — Invariant Hypothesis Mining)
# ==============================================================================
# Selection: auto (OpenRouter -> Anthropic -> Ollama -> Offline) | openrouter | anthropic | ollama | offline
LLM_PROVIDER=auto
ALLOW_AUTO_FALLBACK=true

# Primary Cloud Provider: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supported Cloud Provider: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local Fallback Provider: Ollama (Qwen or Mistral)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ==============================================================================
# Optional Storage & Embeddings
# ==============================================================================
# MongoDB Atlas (invariant storage, vector dedup, certification history)
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=beacon

# Voyage AI embeddings (used by Atlas Vector Search for invariant dedup)
VOYAGE_API_KEY=

# ==============================================================================
# Tunable Scoring Defaults
# ==============================================================================
CONFIDENCE_THRESHOLD=0.8
SEVERITY_WEIGHT_CRITICAL=4
SEVERITY_WEIGHT_HIGH=3
SEVERITY_WEIGHT_MEDIUM=2
SEVERITY_WEIGHT_LOW=1
DRIFT_ALERT_DELTA_PCT=2.0

# ==============================================================================
# Phase 17 Authentication & Security Configuration
# ==============================================================================
# JWT_SECRET_KEY is required for authenticating API requests.
# A real, cryptographically secure secret (minimum 32 characters) must be supplied
# through the deployment environment or a secure secret manager (e.g., AWS Secrets
# Manager, HashiCorp Vault).
# The actual secret must NEVER be committed to Git or hardcoded in configuration files.
# The empty value below is intentional and is only a placeholder; production startup
# will safely fail fast if JWT_SECRET_KEY is missing or empty.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Phase 18 Observability, Logging & Operational Diagnostics Configuration
# ==============================================================================
# Minimum logging level for structured JSON application logs (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Threshold in milliseconds to flag and log slow HTTP requests / operations
SLOW_REQUEST_THRESHOLD_MS=2000

# Toggle in-memory operational metrics collection
METRICS_ENABLED=true

# Application build & version identifier reported in safe version endpoints
BEACON_VERSION=1.0.0


